# Lexius Financeiro — copie para .env e preencha (não commitar .env)

NODE_ENV=development
PORT=3000

# PostgreSQL (obrigatório)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexius_financeiro

# Aplicar schema.sql na subida (apenas dev; em produção use migrate controlado)
DB_SYNC_SCHEMA=false

# JWT (API de usuários)
JWT_SECRET=altere-em-producao-min-32-chars
JWT_EXPIRES_IN=8h

# Integração Lexius COB (POST /v1/integracao/cobranca/acordos)
COB_INTEGRACAO_API_KEY=
COB_INTEGRACAO_HMAC_SECRET=

# Empresa padrão para acordos recebidos do COB (CNPJ só dígitos)
COB_EMPRESA_CNPJ=

# Anexos (armazenamento local em disco)
STORAGE_LOCAL_PATH=./storage
ANEXO_MAX_BYTES=10485760
ANEXO_MIME_ALLOWED=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Banco Inter (mTLS) — chaves por credencial_ref (ex.: ref "inter-cob" → BANCO_CRED_INTER_COB_*)
# Em production: INTER_USE_MOCK e WEBHOOK_INTER_MOCK_SECRET são PROIBIDOS (fail-closed).
INTER_USE_MOCK=true
INTER_SANDBOX=true
WEBHOOK_INTER_MOCK_SECRET=e2e-only-change-me
# INTER_WEBHOOK_CA_PATH=/caminho/ca.crt
# COBRANCA_POLL_INTERVAL_MS=300000
# Conta Inter padrão para emissão Pix de acordos COB (opcional; senão usa a primeira Inter ativa)
# COB_CONTA_BANCARIA_ID=
# PUBLIC_WEBHOOK_INTER_URL=https://seu-host/v1/webhooks/inter
# INTER_API_BASE_URL=https://cdpj-sandbox.partners.uatinter.co
# BANCO_CRED_INTER_COB_CLIENT_ID=
# BANCO_CRED_INTER_COB_CLIENT_SECRET=
# BANCO_CRED_INTER_COB_CERT_PATH=
# BANCO_CRED_INTER_COB_KEY_PATH=